      "events": [
        { "id": "#1", "type": "sinBin", "team": "home", "number": 7, "matchSecond": 100, "warnings": [] },
        { "id": "#2", "type": "sinBin", "team": "home", "number": 7, "matchSecond": 200, "warnings": ["overlappingSinBin"] },
        { "id": "#3", "type": "sinBin", "team": "home", "number": 7, "matchSecond": 1000, "warnings": [], "secondSinBin": true },
        { "id": "#4", "type": "substitution", "team": "home", "numberOut": 7, "numberIn": 12, "matchSecond": 1200, "warnings": [] },
        { "id": "#5", "type": "substitution", "team": "away", "numberOut": 9, "numberIn": 14, "matchSecond": 1500, "warnings": [] },
        { "id": "#6", "type": "red", "team": "away", "number": 9, "matchSecond": 1550, "warnings": ["playerOffPitch"] }
      ] },
    { "at": 2650, "playersOnField": [10, 11],
      "sinBins": [ { "eventId": "#8", "team": "home", "number": 4, "remaining": 550, "second": true } ] },
    { "at": 3000, "phase": "interval", "playersOnField": [10, 11],
      "sinBins": [ { "eventId": "#8", "team": "home", "number": 4, "remaining": 500, "second": true } ] },
    { "at": 3650, "playersOnField": [10, 11],
      "sinBins": [ { "eventId": "#8", "team": "home", "number": 4, "remaining": 450, "second": true } ],
