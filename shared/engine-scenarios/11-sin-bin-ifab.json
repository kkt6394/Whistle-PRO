    { "type": "recordCard", "t": 100, "team": "home", "number": 7, "kind": "sinBin" },
    { "type": "recordCard", "t": 200, "team": "home", "number": 7, "kind": "sinBin" },
    { "type": "recordCard", "t": 1000, "team": "home", "number": 7, "kind": "sinBin" },
    { "type": "recordSubstitution", "t": 1200, "team": "home", "numberOut": 7, "numberIn": 12 },
