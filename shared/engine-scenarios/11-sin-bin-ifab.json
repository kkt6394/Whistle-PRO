    { "at": 4500, "playersOnField": [9, 11],
      "sinBins": [ { "eventId": "#12", "team": "home", "number": 3, "remaining": 500, "second": true } ],
      "nextAlert": { "kind": "secondSinBinEnd", "at": 5000 } },
    { "at": 5050, "playersOnField": [9, 9],
      "barred": [ { "team": "home", "number": 7, "filled": true }, { "team": "home", "number": 4, "filled": false }, { "team": "home", "number": 3, "filled": false } ],
      "sinBins": [ { "eventId": "#13", "team": "away", "remaining": 550 }, { "eventId": "#14", "team": "away", "remaining": 550 } ] },
    { "at": 5150, "playersOnField": [9, 9],
      "barred": [ { "team": "home", "number": 4, "filled": false }, { "team": "home", "number": 3, "filled": false } ] }
