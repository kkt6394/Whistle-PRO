  "expect": [
    { "at": 300, "playersOnField": [10, 11], "barred": [],
      "sinBins": [ { "eventId": "#1", "team": "home", "number": 7, "remaining": 400 } ],
      "events": [
        { "id": "#1", "type": "sinBin", "team": "home", "number": 7, "matchSecond": 100, "warnings": [] },
        { "id": "#2", "type": "sinBin", "team": "home", "number": 7, "matchSecond": 200, "warnings": ["overlappingSinBin"] }
      ] },
    { "at": 900, "playersOnField": [11, 11], "sinBins": [], "barred": [] },
    { "at": 1300, "playersOnField": [10, 11], "barred": [],
