    { "type": "recordCard", "t": 1550, "team": "away", "number": 9, "kind": "red" },
    { "type": "recordCard", "t": 1700, "team": "home", "number": 4, "kind": "sinBin" },
    { "type": "recordCard", "t": 2600, "team": "home", "number": 4, "kind": "sinBin" },
